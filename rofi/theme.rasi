* {
    bg:         #16161e;
    bg-alt:     #1a1b26;
    border-col: #292e42;
    fg:         #c0caf5;
    fg-muted:   #565f89;
    selected:   #292e42;
    accent:     #7aa2f7;
    urgent:     #f7768e;

    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @border-col;
    border-radius:    8px;
    width:            480px;
    padding:          0;
}

mainbox {
    children: [inputbar, listview];
    spacing:  0;
}

inputbar {
    background-color: @bg;
    border:           0 0 1px 0;
    border-color:     @border-col;
    padding:          12px 14px;
    children:         [prompt, entry];
    spacing:          8px;
}

prompt {
    text-color: @fg-muted;
}

entry {
    text-color:   @fg;
    placeholder:  "search...";
    placeholder-color: @fg-muted;
}

listview {
    background-color: @bg;
    padding:          8px;
    spacing:          2px;
    lines:            8;
    scrollbar:        false;
}

element {
    padding:      8px 10px;
    border-radius: 5px;
    spacing:      10px;
    children:     [element-icon, element-text];
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg-muted;
}

element selected.normal {
    background-color: @selected;
    text-color:       @accent;
}

element urgent.normal {
    text-color: @urgent;
}

element-icon {
    size: 20px;
}

element-text {
    vertical-align: 0.5;
}
